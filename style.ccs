.social-icons {
  margin-top: 15px;
}

.social-icons a {
  color: white;
  margin: 0 12px;
  font-size: 22px;
  display: inline-block;
  transition: all 0.3s ease;
}

.social-icons a:hover {
  transform: scale(1.3);
  text-shadow: 0 0 12px #00f7ff;
}

.social-icons a .fa-youtube:hover {
  color: #ff0000;
  text-shadow: 0 0 12px #ff0000;
}

.social-icons a .fa-telegram:hover {
  color: #0088cc;
  text-shadow: 0 0 12px #0088cc;
}

footer {
  color: white;
  text-align: center;
  padding: 20px;
}

footer a {
  color: white;
  text-decoration: none;
}

footer a:hover {
  color: #ccc;
}
