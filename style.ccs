.social-icons {
  margin-top: 15px;
}

.social-icons a {
  color: white;
  margin: 0 12px;
  font-size: 22px;
  display: inline-block;
  transition: all 0.3s ease;
}

.social-icons a:hover {
  transform: scale(1.3);
  text-shadow: 0 0 12px #00f7ff;
}

.social-icons a .fa-youtube:hover {
  color: #ff0000;
  text-shadow: 0 0 12px #ff0000;
}

.social-icons a .fa-telegram:hover {
  color: #0088cc;
  text-shadow: 0 0 12px #0088cc;
}

footer {
  color: white;
  text-align: center;
  padding: 20px;
}

footer a {
  color: white;
  text-decoration: none;
}

footer a:hover {
  color: #ccc;
}


.main-footer {
  background: #111827;
  color: #ffffff;
  text-align: center;
  padding: 40px 20px;
}

.main-footer h2,
.main-footer h3 {
  margin-bottom: 15px;
  font-weight: 500;
}

.main-footer hr {
  border: none;
  height: 1px;
  background: rgba(255,255,255,0.1);
  margin: 30px 0;
}

.social-icons a {
  color: white;
  margin: 0 12px;
  font-size: 22px;
  transition: 0.3s ease;
}

.social-icons a:hover {
  color: #00f7ff;
  transform: scale(1.2);
  text-shadow: 0 0 10px #00f7ff;
}

.telegram-section a {
  display: inline-block;
  margin: 10px 15px;
  padding: 8px 16px;
  background: #0088cc;
  color: white;
  border-radius: 25px;
  text-decoration: none;
  transition: 0.3s ease;
}

.telegram-section a:hover {
  background: #00aaff;
}

.footer-links a {
  display: inline-block;
  margin: 8px 15px;
  color: white;
  text-decoration: none;
  opacity: 0.8;
  transition: 0.3s;
}

.footer-links a:hover {
  opacity: 1;
  color: #00f7ff;
}

.age-warning {
  margin-top: 20px;
}

.badge {
  display: inline-block;
  border: 2px solid red;
  color: red;
  padding: 6px 14px;
  border-radius: 50px;
  font-weight: bold;
  margin-bottom: 10px;
}

.age-warning p {
  font-size: 14px;
  opacity: 0.7;
}

.copyright {
  margin-top: 30px;
  font-size: 14px;
  opacity: 0.6;
}
